boolean ::= ("true" | "false")
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
root ::= "{" space tests-kv space "}"
space ::= " "?
tests ::= "[" space tests-item ("," space tests-item){0,47} space "]"
tests-item ::= "{" space tests-item-inputs-kv "," space tests-item-expected-kv space "}"
tests-item-expected ::= ("\"Approved\"" | "\"Rejected\"" | "\"Referred\"")
tests-item-expected-kv ::= "\"expected\"" space ":" space tests-item-expected
tests-item-inputs ::= "{" space tests-item-inputs-age-kv "," space tests-item-inputs-credit-score-kv "," space tests-item-inputs-monthly-income-kv "," space tests-item-inputs-has-cosigner-kv space "}"
tests-item-inputs-age-kv ::= "\"age\"" space ":" space integer
tests-item-inputs-credit-score-kv ::= "\"credit_score\"" space ":" space integer
tests-item-inputs-has-cosigner-kv ::= "\"has_cosigner\"" space ":" space boolean
tests-item-inputs-kv ::= "\"inputs\"" space ":" space tests-item-inputs
tests-item-inputs-monthly-income-kv ::= "\"monthly_income\"" space ":" space integer
tests-kv ::= "\"tests\"" space ":" space tests
