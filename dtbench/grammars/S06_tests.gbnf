boolean ::= ("true" | "false")
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
root ::= "{" space tests-kv space "}"
space ::= " "?
tests ::= "[" space tests-item ("," space tests-item){0,47} space "]"
tests-item ::= "{" space tests-item-inputs-kv "," space tests-item-expected-kv space "}"
tests-item-expected ::= ("\"Eligible\"" | "\"Not eligible\"")
tests-item-expected-kv ::= "\"expected\"" space ":" space tests-item-expected
tests-item-inputs ::= "{" space tests-item-inputs-age-kv "," space tests-item-inputs-national-resident-kv "," space tests-item-inputs-theory-kv "," space tests-item-inputs-driving-kv "," space tests-item-inputs-maneuvering-kv "," space tests-item-inputs-anticipation-kv space "}"
tests-item-inputs-age-kv ::= "\"age\"" space ":" space integer
tests-item-inputs-anticipation ::= ("\"Excellent\"" | "\"Good\"" | "\"Fail\"")
tests-item-inputs-anticipation-kv ::= "\"anticipation\"" space ":" space tests-item-inputs-anticipation
tests-item-inputs-driving ::= ("\"Excellent\"" | "\"Good\"" | "\"Fail\"")
tests-item-inputs-driving-kv ::= "\"driving\"" space ":" space tests-item-inputs-driving
tests-item-inputs-kv ::= "\"inputs\"" space ":" space tests-item-inputs
tests-item-inputs-maneuvering ::= ("\"Excellent\"" | "\"Good\"" | "\"Fail\"")
tests-item-inputs-maneuvering-kv ::= "\"maneuvering\"" space ":" space tests-item-inputs-maneuvering
tests-item-inputs-national-resident-kv ::= "\"national_resident\"" space ":" space boolean
tests-item-inputs-theory ::= ("\"Excellent\"" | "\"Good\"" | "\"Fail\"")
tests-item-inputs-theory-kv ::= "\"theory\"" space ":" space tests-item-inputs-theory
tests-kv ::= "\"tests\"" space ":" space tests
