boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
conditions ::= "[" space conditions-item ("," space conditions-item){0,15} space "]"
conditions-item ::= "{" space conditions-item-id-kv "," space conditions-item-expr-kv space "}"
conditions-item-expr-kv ::= "\"expr\"" space ":" space string
conditions-item-id-kv ::= "\"id\"" space ":" space string
conditions-kv ::= "\"conditions\"" space ":" space conditions
root ::= "{" space conditions-kv "," space rules-kv space "}"
rules ::= "[" space rules-item ("," space rules-item){0,47} space "]"
rules-item ::= "{" space rules-item-id-kv "," space rules-item-when-kv "," space rules-item-output-kv space "}"
rules-item-id-kv ::= "\"id\"" space ":" space string
rules-item-output ::= ("\"0%\"" | "\"5%\"" | "\"10%\"" | "\"15%\"" | "\"20%\"" | "\"25%\"" | "\"30%\"" | "\"REJECTED\"")
rules-item-output-kv ::= "\"output\"" space ":" space rules-item-output
rules-item-when ::= "{" space  (rules-item-when-additional-kv ( "," space rules-item-when-additional-kv )* )? space "}"
rules-item-when-additional-kv ::= string ":" space boolean
rules-item-when-kv ::= "\"when\"" space ":" space rules-item-when
rules-kv ::= "\"rules\"" space ":" space rules
space ::= " "?
string ::= "\"" char* "\""
