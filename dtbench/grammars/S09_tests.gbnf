boolean ::= ("true" | "false")
integer ::= ("-"? integral-part)
integral-part ::= [0] | [1-9] [0-9]{0,15}
root ::= "{" space tests-kv space "}"
space ::= " "?
tests ::= "[" space tests-item ("," space tests-item){0,47} space "]"
tests-item ::= "{" space tests-item-inputs-kv "," space tests-item-expected-kv space "}"
tests-item-expected ::= ("\"Eligible\"" | "\"Not eligible\"")
tests-item-expected-kv ::= "\"expected\"" space ":" space tests-item-expected
tests-item-inputs ::= "{" space tests-item-inputs-grades-kv "," space tests-item-inputs-annual-income-kv "," space tests-item-inputs-received-other-scholarship-kv space "}"
tests-item-inputs-annual-income-kv ::= "\"annual_income\"" space ":" space integer
tests-item-inputs-grades ::= ("\"excellent\"" | "\"good\"" | "\"average\"" | "\"poor\"")
tests-item-inputs-grades-kv ::= "\"grades\"" space ":" space tests-item-inputs-grades
tests-item-inputs-kv ::= "\"inputs\"" space ":" space tests-item-inputs
tests-item-inputs-received-other-scholarship-kv ::= "\"received_other_scholarship\"" space ":" space boolean
tests-kv ::= "\"tests\"" space ":" space tests
