boolean ::= ("true" | "false")
decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
root ::= "{" space tests-kv space "}"
space ::= " "?
tests ::= "[" space tests-item ("," space tests-item){0,47} space "]"
tests-item ::= "{" space tests-item-inputs-kv "," space tests-item-expected-kv space "}"
tests-item-expected ::= ("\"walk\"" | "\"bike\"" | "\"car\"")
tests-item-expected-kv ::= "\"expected\"" space ":" space tests-item-expected
tests-item-inputs ::= "{" space tests-item-inputs-distance-kv "," space tests-item-inputs-weather-kv "," space tests-item-inputs-hurry-kv space "}"
tests-item-inputs-distance-kv ::= "\"distance\"" space ":" space number
tests-item-inputs-hurry-kv ::= "\"hurry\"" space ":" space boolean
tests-item-inputs-kv ::= "\"inputs\"" space ":" space tests-item-inputs
tests-item-inputs-weather ::= ("\"sunny\"" | "\"cloudy\"" | "\"rainy\"" | "\"freezing\"")
tests-item-inputs-weather-kv ::= "\"weather\"" space ":" space tests-item-inputs-weather
tests-kv ::= "\"tests\"" space ":" space tests
