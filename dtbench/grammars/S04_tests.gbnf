decimal-part ::= [0-9]{1,16}
integral-part ::= [0] | [1-9] [0-9]{0,15}
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)?
root ::= "{" space tests-kv space "}"
space ::= " "?
tests ::= "[" space tests-item ("," space tests-item){0,47} space "]"
tests-item ::= "{" space tests-item-inputs-kv "," space tests-item-expected-kv space "}"
tests-item-expected ::= ("\"Severely underweight\"" | "\"Underweight\"" | "\"Normal\"" | "\"Overweight\"" | "\"Obese\"")
tests-item-expected-kv ::= "\"expected\"" space ":" space tests-item-expected
tests-item-inputs ::= "{" space tests-item-inputs-gender-kv "," space tests-item-inputs-weight-kv "," space tests-item-inputs-length-kv space "}"
tests-item-inputs-gender ::= ("\"male\"" | "\"female\"")
tests-item-inputs-gender-kv ::= "\"gender\"" space ":" space tests-item-inputs-gender
tests-item-inputs-kv ::= "\"inputs\"" space ":" space tests-item-inputs
tests-item-inputs-length-kv ::= "\"length\"" space ":" space number
tests-item-inputs-weight-kv ::= "\"weight\"" space ":" space number
tests-kv ::= "\"tests\"" space ":" space tests
