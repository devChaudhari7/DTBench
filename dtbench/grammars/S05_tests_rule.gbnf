boolean ::= ("true" | "false")
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
root ::= "{" space tests-kv space "}"
space ::= " "?
string ::= "\"" char* "\""
tests ::= "[" space tests-item ("," space tests-item){0,47} space "]"
tests-item ::= "{" space tests-item-rule-kv "," space tests-item-inputs-kv "," space tests-item-expected-kv space "}"
tests-item-expected ::= ("\"No pet\"" | "\"Fish\"" | "\"Cat\"" | "\"Dog\"")
tests-item-expected-kv ::= "\"expected\"" space ":" space tests-item-expected
tests-item-inputs ::= "{" space tests-item-inputs-allergies-kv "," space tests-item-inputs-time-kv "," space tests-item-inputs-kids-kv "," space tests-item-inputs-garden-kv space "}"
tests-item-inputs-allergies-kv ::= "\"allergies\"" space ":" space boolean
tests-item-inputs-garden-kv ::= "\"garden\"" space ":" space boolean
tests-item-inputs-kids-kv ::= "\"kids\"" space ":" space boolean
tests-item-inputs-kv ::= "\"inputs\"" space ":" space tests-item-inputs
tests-item-inputs-time ::= ("\"none\"" | "\"average\"" | "\"a lot\"")
tests-item-inputs-time-kv ::= "\"time\"" space ":" space tests-item-inputs-time
tests-item-rule-kv ::= "\"rule\"" space ":" space string
tests-kv ::= "\"tests\"" space ":" space tests
