{
 "conditions": [
  {
   "id": "C1",
   "expr": "amount > 100000"
  },
  {
   "id": "C2",
   "expr": "new_payee == True and amount > 5000"
  },
  {
   "id": "C3",
   "expr": "registered_device == False and amount > 2000"
  }
 ],
 "rules": [
  {
   "id": "R1",
   "when": {
    "C1": false,
    "C2": false,
    "C3": false
   },
   "output": "Allowed"
  },
  {
   "id": "R2",
   "when": {
    "C1": false,
    "C2": false,
    "C3": true
   },
   "output": "OTP required"
  },
  {
   "id": "R3",
   "when": {
    "C1": false,
    "C2": true,
    "C3": true
   },
   "output": "On hold"
  },
  {
   "id": "R4",
   "when": {
    "C1": false,
    "C2": true,
    "C3": false
   },
   "output": "On hold"
  },
  {
   "id": "R5",
   "when": {
    "C1": true,
    "C2": false,
    "C3": true
   },
   "output": "Blocked"
  },
  {
   "id": "R6",
   "when": {
    "C1": true,
    "C2": false,
    "C3": false
   },
   "output": "Blocked"
  },
  {
   "id": "R7",
   "when": {
    "C1": true,
    "C2": true,
    "C3": true
   },
   "output": "Blocked"
  },
  {
   "id": "R8",
   "when": {
    "C1": true,
    "C2": true,
    "C3": false
   },
   "output": "Blocked"
  }
 ]
}