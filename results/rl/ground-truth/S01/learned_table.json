{
 "conditions": [
  {
   "id": "C1",
   "expr": "a < b + c"
  },
  {
   "id": "C2",
   "expr": "b < a + c"
  },
  {
   "id": "C3",
   "expr": "c < a + b"
  },
  {
   "id": "C4",
   "expr": "a == b"
  },
  {
   "id": "C5",
   "expr": "a == c"
  },
  {
   "id": "C6",
   "expr": "b == c"
  }
 ],
 "rules": [
  {
   "id": "R1",
   "when": {
    "C1": true,
    "C2": true,
    "C3": true,
    "C4": true,
    "C5": true,
    "C6": true
   },
   "output": "Equilateral"
  },
  {
   "id": "R2",
   "when": {
    "C1": true,
    "C2": true,
    "C3": false,
    "C4": true,
    "C5": false,
    "C6": false
   },
   "output": "Not a triangle"
  },
  {
   "id": "R3",
   "when": {
    "C1": true,
    "C2": false,
    "C3": true,
    "C4": false,
    "C5": true,
    "C6": false
   },
   "output": "Not a triangle"
  },
  {
