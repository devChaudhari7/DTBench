{
 "conditions": [
  {
   "id": "C1",
   "expr": "grades in ('excellent', 'good')"
  },
  {
   "id": "C2",
   "expr": "annual_income < 50000"
  },
  {
   "id": "C3",
   "expr": "received_other_scholarship"
  }
 ],
 "rules": [
  {
   "id": "R1",
