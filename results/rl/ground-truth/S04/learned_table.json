{
 "conditions": [
  {
   "id": "C1",
   "expr": "weight / (length * length) > 30"
  },
  {
   "id": "C2",
   "expr": "weight / (length * length) >= 25"
  },
  {
   "id": "C3",
   "expr": "weight / (length * length) >= 18.5"
  },
  {
   "id": "C4",
   "expr": "gender == 'male'"
  }
 ],
 "rules": [
  {
   "id": "R1",
   "when": {
    "C1": false,
    "C2": false,
    "C3": false,
    "C4": true
   },
   "output": "Severely underweight"
  },
  {
   "id": "R2",
   "when": {
    "C1": false,
    "C2": true,
    "C3": true,
    "C4": true
   },
   "output": "Normal"
  },
  {
   "id": "R3",
   "when": {
    "C1": true,
    "C2": true,
    "C3": true,
    "C4": true
   },
   "output": "Obese"
  },
  {
   "id": "R4",
   "when": {
    "C1": false,
    "C2": false,
    "C3": true,
    "C4": true
   },
   "output": "Underweight"
  },
  {
   "id": "R5",
   "when": {
    "C1": false,
    "C2": false,
    "C3": false,
    "C4": false
   },
   "output": "Underweight"
  },
  {
   "id": "R6",
   "when": {
    "C1": false,
    "C2": true,
    "C3": true,
    "C4": false
   },
   "output": "Overweight"
  },
  {
   "id": "R7",
   "when": {
    "C1": true,
    "C2": true,
    "C3": true,
    "C4": false
   },
   "output": "Obese"
  },
  {
   "id": "R8",
   "when": {
    "C1": false,
    "C2": false,
    "C3": true,
    "C4": false
   },
   "output": "Normal"
  }
 ]
}