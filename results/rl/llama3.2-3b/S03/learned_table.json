{
 "conditions": [
  {
   "id": "C1",
   "expr": "cart_value < 1000"
  },
  {
   "id": "C2",
   "expr": "cart_value >= 1000 and cart_value < 2000"
  },
  {
   "id": "C3",
   "expr": "cart_value >= 2000 and cart_value < 5000"
  },
  {
   "id": "C4",
   "expr": "cart_value >= 5000"
  }
 ],
 "rules": [
  {
   "id": "R1",
   "when": {
    "C1": true,
    "C2": false,
    "C3": false,
    "C4": false
   },
   "output": "0%"
  },
  {
   "id": "R2",
   "when": {
    "C1": false,
    "C2": true,
    "C3": false,
    "C4": false
   },
   "output": "REJECTED"
  },
  {
   "id": "R3",
   "when": {
    "C1": false,
    "C2": false,
    "C3": true,
    "C4": false
   },
   "output": "25%"
  },
  {
   "id": "R4",
   "when": {
    "C1": false,
    "C2": false,
    "C3": false,
    "C4": true
   },
   "output": "REJECTED"
  }
 ]
}