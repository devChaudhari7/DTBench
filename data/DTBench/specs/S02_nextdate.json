  "reference_source": "\"\"\"S02 NextDate: which action produces the next date (Jorgensen 2013, ch. 7).\"\"\"\n\n\ndef is_leap(year):\n    return (year % 4 == 0 and year % 100 != 0) or year % 400 == 0\n\n\ndef decide(day, month, year):\n    if month == 2:\n        if is_leap(year):\n            last = 29\n        else:\n            last = 28\n    elif month in (4, 6, 9, 11):\n        last = 30\n    else:\n        last = 31\n    if day > last:\n        return \"Invalid date\"\n    if day < last:\n        return \"Next day same month\"\n    if month == 12:\n        return \"First day of next year\"\n    return \"First day of next month\"\n"
