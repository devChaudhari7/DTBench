  "reference_source": "\"\"\"S03 Order discount with tiers, coupon, membership and a 30% cap.\"\"\"\n\n\ndef decide(cart_value, coupon, member):\n    if coupon == \"invalid\":\n        return \"REJECTED\"\n    if cart_value >= 5000:\n        rate = 20\n    elif cart_value >= 2000:\n        rate = 10\n    elif cart_value >= 1000:\n        rate = 5\n    else:\n        rate = 0\n    if coupon == \"valid\":\n        rate = rate + 10\n    if member:\n        rate = rate + 5\n    if rate > 30:\n        rate = 30\n    return str(rate) + \"%\"\n"
}