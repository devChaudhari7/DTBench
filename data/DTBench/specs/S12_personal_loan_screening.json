{
  "id": "S12",
  "name": "Personal-loan screening",
  "category": "Business rules (authored)",
  "source": "Authored for this benchmark",
  "source_url": "",
  "rules_text": "A bank screens personal-loan applications. Applicants younger than 21 years are \"Rejected\". Applicants aged 21 or more are assessed on their credit score: a score below 600 is \"Rejected\" and a score of 750 or above is \"Approved\". For a credit score from 600 to 749, the application is \"Approved\" if the monthly income is at least Rs. 50000; if the income is lower, the application is \"Approved\" only when there is a co-signer, and otherwise it is \"Referred\" to a loan officer.",
  "clarifications": "",
  "inputs": [
    {
      "name": "age",
      "type": "int",
      "min": 18,
      "max": 75,
      "values": null,
      "description": ""
    },
    {
      "name": "credit_score",
      "type": "int",
      "min": 300,
      "max": 900,
      "values": null,
      "description": ""
    },
    {
      "name": "monthly_income",
      "type": "int",
      "min": 0,
      "max": 500000,
      "values": null,
      "description": "rupees"
    },
    {
      "name": "has_cosigner",
      "type": "bool",
      "min": null,
      "max": null,
      "values": null,
      "description": ""
    }
  ],
  "constraint": null,
  "constraint_description": null,
  "output": {
    "name": "decision",
    "type": "enum",
    "values": [
      "Approved",
      "Rejected",
      "Referred"
    ]
  },
  "ground_truth_table": {
    "conditions": [
      {
        "id": "C1",
        "expr": "age < 21"
      },
      {
        "id": "C2",
        "expr": "credit_score < 600"
      },
      {
        "id": "C3",
        "expr": "credit_score >= 750"
      },
      {
        "id": "C4",
        "expr": "monthly_income >= 50000"
      },
      {
        "id": "C5",
        "expr": "has_cosigner"
      }
    ],
    "rules": [
      {
        "id": "R1",
        "when": {
          "C1": true
        },
        "output": "Rejected"
      },
      {
        "id": "R2",
        "when": {
          "C1": false,
          "C2": true
        },
        "output": "Rejected"
      },
      {
        "id": "R3",
        "when": {
          "C1": false,
          "C3": true
        },
        "output": "Approved"
      },
      {
        "id": "R4",
        "when": {
          "C1": false,
          "C2": false,
          "C3": false,
          "C4": true
        },
        "output": "Approved"
      },
      {
        "id": "R5",
        "when": {
          "C1": false,
          "C2": false,
          "C3": false,
          "C4": false,
          "C5": true
        },
        "output": "Approved"
      },
      {
        "id": "R6",
        "when": {
          "C1": false,
          "C2": false,
          "C3": false,
          "C4": false,
          "C5": false
        },
        "output": "Referred"
      }
    ]
  },
  "infeasible_rules": [],
  "n_feasible_rules": 6,
  "tags": [
    "thresholds",
    "precedence",
    "finance"
  ],
  "reference_implementation": "reference/s12_loan.py",
  "reference_source": "\"\"\"S12 Personal-loan screening (authored for this benchmark).\"\"\"\n\n\ndef decide(age, credit_score, monthly_income, has_cosigner):\n    if age < 21 or credit_score < 600:\n        return \"Rejected\"\n    if credit_score >= 750 or monthly_income >= 50000 or has_cosigner:\n        return \"Approved\"\n    return \"Referred\"\n"
}