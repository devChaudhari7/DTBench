{
  "id": "S11",
  "name": "UPI transfer screening",
  "category": "Business rules (authored)",
  "source": "Authored for this benchmark (simplified; not an official NPCI rule set)",
  "source_url": "",
  "rules_text": "A payment app screens every UPI money transfer before sending it. A transfer of more than Rs. 100000 is blocked because it exceeds the per-transaction limit, and the output is \"Blocked\". Otherwise, a transfer to a new payee (a payee added less than 24 hours ago) is put \"On hold\" if the amount is more than Rs. 5000. In all other cases, if the user is not on their registered device and the amount is more than Rs. 2000, the app asks for an OTP and the output is \"OTP required\". Every remaining transfer is \"Allowed\".",
  "clarifications": "",
  "inputs": [
    {
      "name": "amount",
      "type": "int",
      "min": 1,
      "max": 200000,
      "values": null,
      "description": "rupees"
    },
    {
      "name": "new_payee",
      "type": "bool",
      "min": null,
      "max": null,
      "values": null,
      "description": ""
    },
    {
      "name": "registered_device",
      "type": "bool",
      "min": null,
      "max": null,
      "values": null,
      "description": ""
    }
  ],
  "constraint": null,
  "constraint_description": null,
  "output": {
    "name": "decision",
    "type": "enum",
    "values": [
      "Blocked",
      "On hold",
      "OTP required",
      "Allowed"
    ]
  },
  "ground_truth_table": {
    "conditions": [
      {
        "id": "C1",
        "expr": "amount > 100000"
      },
      {
        "id": "C2",
        "expr": "new_payee"
      },
      {
        "id": "C3",
        "expr": "amount > 5000"
      },
      {
        "id": "C4",
        "expr": "registered_device"
      },
      {
        "id": "C5",
        "expr": "amount > 2000"
      }
    ],
    "rules": [
      {
        "id": "R1",
        "when": {
          "C1": true
        },
        "output": "Blocked"
      },
      {
        "id": "R2",
        "when": {
          "C1": false,
          "C2": true,
          "C3": true
        },
        "output": "On hold"
      },
      {
        "id": "R3",
        "when": {
          "C1": false,
          "C2": true,
          "C3": false,
          "C4": false,
          "C5": true
        },
        "output": "OTP required"
      },
      {
        "id": "R4",
        "when": {
          "C1": false,
          "C2": true,
          "C3": false,
          "C4": false,
          "C5": false
        },
        "output": "Allowed"
      },
      {
        "id": "R5",
        "when": {
          "C1": false,
          "C2": true,
          "C3": false,
          "C4": true
        },
        "output": "Allowed"
      },
      {
        "id": "R6",
        "when": {
          "C1": false,
          "C2": false,
          "C4": false,
          "C5": true
        },
        "output": "OTP required"
      },
      {
        "id": "R7",
        "when": {
          "C1": false,
          "C2": false,
          "C4": false,
          "C5": false
        },
        "output": "Allowed"
      },
      {
        "id": "R8",
        "when": {
          "C1": false,
          "C2": false,
          "C4": true
        },
        "output": "Allowed"
      }
    ]
  },
  "infeasible_rules": [],
  "n_feasible_rules": 8,
  "tags": [
    "thresholds",
    "precedence",
    "payments"
  ],
  "reference_implementation": "reference/s11_upi.py",
  "reference_source": "\"\"\"S11 UPI transfer screening (authored for this benchmark; simplified, not an NPCI rule set).\"\"\"\n\n\ndef decide(amount, new_payee, registered_device):\n    if amount > 100000:\n        return \"Blocked\"\n    if new_payee and amount > 5000:\n        return \"On hold\"\n    if not registered_device and amount > 2000:\n        return \"OTP required\"\n    return \"Allowed\"\n"
}